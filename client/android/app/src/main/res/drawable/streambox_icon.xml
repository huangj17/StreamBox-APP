<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy TV launchers receive a complete opaque icon, including its black background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="80dp" android:height="80dp" />
            <solid android:color="@color/streambox_icon_background" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="fill" />
    </item>
</layer-list>
